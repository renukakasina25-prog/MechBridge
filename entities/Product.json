{
  "name": "Product",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Product name"
    },
    "part_code": {
      "type": "string",
      "description": "Unique part identifier"
    },
    "category": {
      "type": "string",
      "enum": [
        "bearing",
        "piston_kit",
        "bracket",
        "brake_pedal",
        "brake_shoe",
        "speedometer_cable",
        "accelerator_cable",
        "brake_cable",
        "clutch_cable",
        "cam_chain",
        "cam_chain_kit",
        "camshaft",
        "carburetor",
        "spark_plug",
        "chain",
        "chain_case",
        "chain_sprocket",
        "chain_tensioner",
        "clutch_plate",
        "clutch_set",
        "crankshaft",
        "cylinder_head",
        "damper",
        "disc_brake",
        "disc_pad",
        "ecu",
        "air_filter",
        "oil_filter",
        "fan_cover",
        "front_wheel",
        "fuel_pump",
        "gasket",
        "gear",
        "handle_bar",
        "head_light",
        "holder_steer",
        "horn",
        "hub_front",
        "kick_lever",
        "kit_chain_guide",
        "kit_clutch_plate",
        "kit_engine_gasket",
        "kit_major_caliper",
        "kit_minor_caliper",
        "magnet_assy",
        "oil_seal",
        "rear_fender",
        "rear_hub",
        "shock_absorber",
        "regulator",
        "seal_oil",
        "side_indicator",
        "side_stand",
        "spark_plug_wire",
        "speedometer",
        "starter_motor",
        "stator",
        "steering_cone",
        "tapet",
        "tail_lamp",
        "vacuum_piston",
        "valve_kit",
        "wheel_front",
        "wheel_rear",
        "windshield",
        "wiring_harness"
      ],
      "description": "Product category"
    },
    "subcategory": {
      "type": "string",
      "description": "Specific part type"
    },
    "vehicle_type": {
      "type": "string",
      "enum": [
        "bike",
        "scooter",
        "e_auto",
        "universal"
      ],
      "description": "Compatible vehicle type"
    },
    "brand": {
      "type": "string",
      "description": "Vehicle brand compatibility"
    },
    "model": {
      "type": "string",
      "description": "Specific model compatibility"
    },
    "price": {
      "type": "number",
      "description": "Price in INR"
    },
    "original_price": {
      "type": "number",
      "description": "Original price before discount"
    },
    "stock_quantity": {
      "type": "number",
      "description": "Available stock"
    },
    "image_url": {
      "type": "string",
      "description": "Product image URL"
    },
    "description": {
      "type": "string",
      "description": "Detailed product description"
    },
    "features": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Key product features"
    },
    "is_featured": {
      "type": "boolean",
      "default": false,
      "description": "Featured product flag"
    },
    "rating": {
      "type": "number",
      "minimum": 0,
      "maximum": 5,
      "description": "Product rating"
    },
    "compatibility_info": {
      "type": "string",
      "description": "Detailed compatibility information"
    }
  },
  "required": [
    "name",
    "part_code",
    "category",
    "vehicle_type",
    "price"
  ]
}
